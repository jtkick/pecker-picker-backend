SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.12,triangulum.cc
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MinIO / S3 object storage
# MINIO_ENDPOINT_URL is overridden per-environment:
#   docker-compose: http://minio:9000  (set automatically by compose)
#   local dev:      http://localhost:9000
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ROOT_USER=peckeradmin
MINIO_ROOT_PASSWORD=ChangeMeNow123!
MINIO_ACCESS_KEY=peckeradmin
MINIO_SECRET_KEY=ChangeMeNow123!
MINIO_BUCKET=pecker-picker

# Public URL clients use to load images directly from MinIO.
# To migrate to S3: set to https://your-bucket.s3.amazonaws.com
MEDIA_PUBLIC_URL=http://triangulum.cc:9000

# Twilio — leave blank to print OTPs to console in dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
