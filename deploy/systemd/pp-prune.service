[Unit]
Description=Pecker Picker: delete expired auth rows and blacklisted tokens
After=docker.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/srv/pecker-picker-backend
ExecStart=/usr/bin/docker compose -f docker-compose.prod.yml exec -T backend sh -c "python manage.py prune && python manage.py flushexpiredtokens"
