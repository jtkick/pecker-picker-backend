# Production .env for docker-compose.prod.yml. Copy to .env on the server
# (chmod 600) and fill in every value. Never commit the real file.

# ── Domain ──────────────────────────────────────────────────────────────────
# Bare domain, no scheme. The API is served at api.$DOMAIN.
DOMAIN=example.com

# ── Django ──────────────────────────────────────────────────────────────────
DEBUG=False
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=api.example.com,example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com

# ── Postgres (POSTGRES_HOST is set by compose) ───────────────────────────────
POSTGRES_DB=pecker_picker
POSTGRES_USER=pecker_picker
# openssl rand -hex 32
POSTGRES_PASSWORD=

# ── Cloudflare R2 (media) ────────────────────────────────────────────────────
# Clients load media from presigned URLs on the S3 endpoint; R2 custom
# domains don't accept presigned URLs, so both URLs are the account endpoint.
MINIO_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
MEDIA_PUBLIC_URL=https://<account-id>.r2.cloudflarestorage.com
MINIO_REGION=auto
MINIO_BUCKET=pecker-picker-media
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MEDIA_URL_EXPIRY_SECONDS=21600

# ── Passkeys (RP ID is permanent: changing it voids every passkey) ───────────
WEBAUTHN_RP_ID=example.com
WEBAUTHN_RP_NAME=Pecker Picker
WEBAUTHN_ORIGINS=https://example.com
# keytool -list -v -keystore release.jks  → SHA256 line
ANDROID_SHA256_CERT_FINGERPRINT=

# ── Push (Firebase) ──────────────────────────────────────────────────────────
# Service-account JSON saved in ./secrets/ on the server.
FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase.json

# ── AWS Rekognition ──────────────────────────────────────────────────────────
AWS_REKOGNITION_REGION=us-east-1
AWS_REKOGNITION_ACCESS_KEY_ID=
AWS_REKOGNITION_SECRET_ACCESS_KEY=

# ── Twilio Verify ────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ── Stripe (test mode for the beta: sk_test_…) ───────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TIER1=
STRIPE_SUCCESS_URL=https://example.com/subscription/success
STRIPE_CANCEL_URL=https://example.com/subscription/cancel
